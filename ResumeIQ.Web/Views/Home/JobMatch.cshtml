@{
    ViewData["Title"] = "Job Description Matcher";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-bullseye"></i> Job Fit Analyzer</h3>
                </div>
                <div class="card-body p-5">
                    <form asp-controller="Home" asp-action="AnalyzeJobMatch" method="post" enctype="multipart/form-data">
                        <div class="mb-4">
                            <label class="form-label fw-bold">1. Upload Resume (PDF)</label>
                            <input type="file" name="resumeFile" class="form-control" accept=".pdf,.docx" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">2. Paste Job Description</label>
                            <textarea name="jobDescription" class="form-control" rows="6" placeholder="Paste the target job description here..." required></textarea>
                        </div>
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary btn-lg px-5">Analyze Match</button>
                        </div>

                        <!-- Spinner Block -->
                        <div id="loading-spinner" class="d-none text-center mt-3">
                            <div class="spinner-border text-primary" role="status"></div>
                            <h6 class="mt-2 fw-bold text-secondary" id="loading-text">Extracting PDF structures...</h6>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Script specific to the Job Matcher -->
<script>
    document.querySelectorAll('form').forEach(form => {
        form.addEventListener('submit', function(e) {
            const fileInput = form.querySelector('input[type="file"]');
            const submitBtn = form.querySelector('button[type="submit"]');
            const spinner = document.getElementById('loading-spinner');
            const loadingText = document.getElementById('loading-text');

            // 1. File Size Validation
            if (fileInput && fileInput.files.length > 0) {
                if (fileInput.files[0].size > 5 * 1024 * 1024) {
                    e.preventDefault();
                    alert("Evaluation Security: File size exceeds the 5MB limit. Please upload a smaller file.");
                    return;
                }
            }

            // 2. UI Updates (Hide button, show spinner)
            if (submitBtn) submitBtn.classList.add('d-none');
            if (spinner) spinner.classList.remove('d-none');

            // 3. Dynamic Text Updates (Customized for Job Matcher)
            if (loadingText) {
                setTimeout(() => loadingText.innerText = "Extracting target keywords from job description...", 1500);
                setTimeout(() => loadingText.innerText = "Calculating AI match percentage...", 3500);
                setTimeout(() => loadingText.innerText = "Finalizing gap analysis report...", 5000);
            }
        });
    });
</script>
